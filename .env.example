# ============================================================
# SYNAPSE AGENT — Required Environment Variables for Railway
# ============================================================
# Copy this file to .env and fill in your values.
# In Railway, set these in Service → Variables.
# ============================================================

# ---- REQUIRED ----

# Port (Railway sets this automatically, but define a default)
PORT=3000

# PostgreSQL connection string
# Railway provides this automatically when you add a PostgreSQL plugin.
# Format: postgresql://user:pass@host:port/dbname
DATABASE_URL=postgresql://user:pass@host:5432/synapse

# OpenRouter API key — get it at https://openrouter.ai/keys
# This is what powers ALL AI models (Claude, GPT-4o, Gemini, etc.)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- OPTIONAL (Clerk Authentication) ----

# If you want Clerk auth (sign-in / sign-up / user management):
# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ---- OPTIONAL (Telegram Bot Integration) ----

# If you want the Telegram bot integration:
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# BOT_API_SECRET=your-random-secret-string

# ---- OPTIONAL (Workspace) ----

# Root directory for agent file operations.
# On Railway, the filesystem is ephemeral — files created by the AI
# agent will be lost when the container restarts. For persistent
# storage, consider adding a Railway Volume mounted at this path.
# WORKSPACE_ROOT=/app/workspace